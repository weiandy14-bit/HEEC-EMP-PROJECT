{
  "name": "@heec/api",
  "version": "1.0.0",
  "description": "MEP 專案管理系統 API（NestJS + PostgreSQL）",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --experimental-transform-types src/main.ts",
    "test": "node --test --experimental-transform-types 'test/**/*.test.ts'",
    "test:integration": "node --test test/integration/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:exchange": "node --test test/exchange/*.test.mjs"
  },
  "dependencies": {
    "@heec/scheduler": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "luxon": "^3.7.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
