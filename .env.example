# HEEC EMP — environment template. Copy to .env and fill in. NEVER commit real
# secrets; in production inject these via the platform's secret store
# (Cloudflare/Fly/Render/Railway secrets, Kubernetes Secrets, etc.).

# ---- Core ----
NODE_ENV=production
PORT=3000
APP_VERSION=                      # surfaced in /metrics app_build_info

# ---- Database (Neon or any managed PostgreSQL 16) ----
# Production should connect as the least-privilege role app_rw (see 0023_rls.sql)
# once per-request app.current_org wiring is enabled; otherwise the superuser URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PG_POOL_MAX=10

# ---- Identity: enterprise OIDC SSO (DB remains authoritative for org/roles) ----
OIDC_ISSUER=                      # e.g. https://login.microsoftonline.com/<tenant>/v2.0
OIDC_AUDIENCE=                    # the API's expected audience / client id
# OIDC_JWKS_URI=                  # optional; derived from issuer discovery when unset
# OIDC_CLOCK_SKEW=60              # seconds
# OIDC_JWKS_TTL_MS=600000
# OIDC_HTTP_TIMEOUT_MS=5000
# AUTH_CONTEXT_TTL_MS=30000       # resolved-context cache; 0 disables
# AUTH_SESSION_WINDOW_MS=300000   # login_events throttle window
# Development identity shim — NOT a login scheme. Disabled in production unless:
# AUTH_DEV_HEADERS=1

# ---- Private object storage ----
STORAGE_DRIVER=s3                 # local | s3
# local driver:
# EXCHANGE_STORAGE_DIR=/var/lib/heec/exchange
# s3 driver (AWS S3 / Cloudflare R2 / MinIO):
S3_ENDPOINT=                      # e.g. https://<acct>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true          # true for R2/MinIO; false for AWS virtual-hosted
# S3_PREFIX=
# S3_HTTP_TIMEOUT_MS=15000

# ---- Virus scanning (fail-closed) ----
# The clamdscan client reads /etc/clamav/clamd.conf (TCPAddr/TCPSocket). There is
# NO production scan bypass; the test-only bypass requires BOTH of these and is
# refused in production:
# EXCHANGE_TEST_SCANNER=1         # test only (with NODE_ENV=test)

# ---- Observability ----
# LOG_REQUESTS=1                  # 0 silences the JSON access log (metrics still recorded)

# ---- Backups ----
# BACKUP_DIR=/var/backups/heec
